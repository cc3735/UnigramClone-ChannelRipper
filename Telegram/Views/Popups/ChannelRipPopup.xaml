<controls:ContentPopup x:Class="Telegram.Views.Popups.ChannelRipPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       xmlns:viewModels="using:Telegram.ViewModels"
                       mc:Ignorable="d"
                       IsDismissButtonVisible="True"
                       ContentMinWidth="1180"
                       ContentMaxWidth="1500"
                       ContentMinHeight="860"
                       ContentMaxHeight="980"
                       Padding="0,20,0,0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="24,0,0,16"
                    Spacing="12">
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Content="{CustomResource ChannelRipperStartPause}"
                        Click="StartPause_Click" />
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="{CustomResource ChannelRipperAddTarget}"
                        Click="AddTarget_Click" />
                <Button Grid.Row="1"
                        Grid.Column="0"
                        Content="{CustomResource Folder}"
                        Click="PickRoot_Click" />
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Content="Backup"
                        Click="PickBackup_Click" />
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="WrapWholeWords" />

            <TextBlock Text="{CustomResource ChannelRipperInfoText}"
                       Style="{StaticResource InfoCaptionTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.RootPath, Mode=OneWay}"
                       Style="{StaticResource InfoCaptionTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.BackupPath, Mode=OneWay}"
                       Style="{StaticResource InfoCaptionTextBlockStyle}" />

            <ComboBox Header="Dedupe mode"
                      ItemsSource="{x:Bind ViewModel.DedupeModes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDedupeMode, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectionChanged="DedupeMode_SelectionChanged" />
            <ComboBox Header="Output layout"
                      ItemsSource="{x:Bind ViewModel.LayoutModes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedLayoutMode, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectionChanged="LayoutMode_SelectionChanged" />
            <ComboBox Header="Sort targets"
                      ItemsSource="{x:Bind ViewModel.SortModes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedSortMode, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <CheckBox Content="Show active targets only"
                      IsChecked="{x:Bind ViewModel.ShowActiveOnly, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind ViewModel.LastError, Mode=OneWay}"
                       Style="{StaticResource InfoCaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="WrapWholeWords" />

            <Border x:Name="InlineEditPanel"
                    Visibility="Collapsed"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="InlineEditTitle"
                               Text="Edit target"
                               Style="{StaticResource BaseTextBlockStyle}" />
                    <TextBlock x:Name="InlineEditHint"
                               Style="{StaticResource InfoCaptionTextBlockStyle}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="Media types"
                               Style="{StaticResource BaseTextBlockStyle}" />
                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                        <CheckBox x:Name="InlineVideosCheckBox" Content="Videos" Margin="0,0,16,8" />
                        <CheckBox x:Name="InlinePhotosCheckBox" Content="Photos" Margin="0,0,16,8" />
                        <CheckBox x:Name="InlineAnimationsCheckBox" Content="Animations" Margin="0,0,16,8" />
                        <CheckBox x:Name="InlineVideoNotesCheckBox" Content="Video notes" Margin="0,0,16,8" />
                        <CheckBox x:Name="InlineVideoDocumentsCheckBox" Content="Video documents" Margin="0,0,16,8" />
                    </WrapGrid>
                    <StackPanel x:Name="InlineTopicsPanel" Spacing="6">
                        <TextBlock Text="Forum topics"
                                   Style="{StaticResource BaseTextBlockStyle}" />
                        <TextBlock Text="Known topics"
                                   Style="{StaticResource InfoCaptionTextBlockStyle}" />
                        <TextBox x:Name="InlineKnownTopicsTextBox"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Height="180"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Top" />
                        <TextBlock Text="Selected topic IDs (comma-separated, blank = all topics)"
                                   Style="{StaticResource InfoCaptionTextBlockStyle}" />
                        <TextBox x:Name="InlineSelectedTopicIdsTextBox"
                                 PlaceholderText="Example: 12345, 67890" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply" Click="InlineEditApply_Click" />
                        <Button Content="Cancel" Click="InlineEditCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1"
              Margin="24,0,24,16">
            <ListView x:Name="TargetsList"
                      ItemsSource="{x:Bind ViewModel.Items}"
                      SelectionMode="None"
                      MinHeight="820">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ChannelRipTargetViewModel">
                        <Border Margin="0,8"
                                Padding="0,0,0,8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   Style="{StaticResource BaseTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Details, Mode=OneWay}"
                                                   Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Visibility="{x:Bind IsForumTarget, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="ToggleExpand_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind ExpandButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Visibility="{x:Bind TopicPanelVisibility, Mode=OneWay}"
                                            Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{x:Bind TopicFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Filter topics by name or ID"
                                                 TextChanged="TopicFilter_TextChanged" />
                                        <Button Grid.Column="1"
                                                Content="Refresh topics"
                                                Click="RefreshTopics_Click" />
                                    </Grid>

                                    <TextBlock Text="{x:Bind TopicModeHint, Mode=OneWay}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind TopicStatusHint, Mode=OneWay}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}"
                                               TextWrapping="WrapWholeWords" />

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Selected topics"
                                                       Visibility="{x:Bind HasVisibleSelectedTopics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                            <ScrollViewer Height="360"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Visibility="{x:Bind HasVisibleSelectedTopics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{x:Bind FilteredTopicItems, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ChannelRipTopicItemViewModel">
                                                            <Grid Margin="0,1,0,0" ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Label, Mode=OneWay}"
                                                                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Content="Remove topic"
                                                                        Click="RemoveTopic_Click" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Available topics"
                                                       Visibility="{x:Bind HasVisibleAvailableTopics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                            <ScrollViewer Height="360"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Visibility="{x:Bind HasVisibleAvailableTopics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{x:Bind FilteredAvailableTopicItems, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ChannelRipTopicItemViewModel">
                                                            <Grid Margin="0,1,0,0" ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{x:Bind Label, Mode=OneWay}"
                                                                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Content="Add topic"
                                                                        Click="AddTopic_Click" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{x:Bind BackfillStateText, Mode=OneWay}"
                                           Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}"
                                             Maximum="{x:Bind ProgressMax, Mode=OneWay}"
                                             Height="6"
                                             Margin="0,4,0,4" />
                                <TextBlock Text="{x:Bind ProgressSummary, Mode=OneWay}"
                                           Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}"
                                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Bind State, Mode=OneWay}" Click="ToggleTarget_Click" />
                                    <Button Content="{x:Bind EditButtonText, Mode=OneWay}"
                                            Click="EditTarget_Click"
                                            IsEnabled="{x:Bind CanEditInPopup, Mode=OneWay}" />
                                    <Button Content="Open folder" Click="OpenTargetFolder_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{CustomResource Delete}" Click="RemoveTarget_Click" />
                                    <Button Content="{CustomResource ChannelRipperResetTarget}" Click="ResetTarget_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</controls:ContentPopup>
