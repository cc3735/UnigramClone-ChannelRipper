<controls:ContentPopup x:Class="Telegram.Views.Popups.ChannelRipTopicPickerPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       xmlns:td="using:Telegram.Td.Api"
                       mc:Ignorable="d"
                       PrimaryButtonText="OK"
                       SecondaryButtonText="Cancel"
                       PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
                       Padding="0,16,0,0"
                       ContentMinWidth="420">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintLabel"
                   Margin="24,0,24,12"
                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                   TextWrapping="WrapWholeWords" />

        <ListView x:Name="TopicList"
                  Grid.Row="1"
                  SelectionMode="Multiple"
                  SelectionChanged="TopicList_SelectionChanged"
                  ContainerContentChanging="TopicList_ContainerContentChanging"
                  MinHeight="240">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="td:ForumTopic">
                    <Grid Margin="24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Info.Name, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind UnreadCount, Mode=OneWay}"
                                   Style="{StaticResource InfoCaptionTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</controls:ContentPopup>
